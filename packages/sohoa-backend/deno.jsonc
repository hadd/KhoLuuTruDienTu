{
  "tasks": {
    "dev": "NODE_ENV=development deno run --watch --allow-all main.ts",
    "dev-local": "NODE_ENV=local deno run --watch --allow-all main.ts",
    "start": "deno run --allow-all main.ts",
    "db:generate": "deno run -A npm:drizzle-kit generate --config=drizzle.config.ts",
    "db:create-schema": "deno run -A ./scripts/migrations/create-schema.ts",
    "db:migrate": "deno run -A ./scripts/migrations/migrate.ts",
    "db:prepare": "deno run -A ./scripts/migrations/db-prepare.ts",
    "db:push": "deno run -A npm:drizzle-kit push --config=drizzle.config.ts",
    "db:reset": "deno run -A ./scripts/migrations/db-reset.ts",
    "db:clean-migrations": "deno run -A ./scripts/migrations/clean-migrations.ts",
    "db:check-migrations": "deno run -A ./scripts/migrations/check-migrations.ts",
    "db:rebuild-snapshot": "deno run -A ./scripts/migrations/rebuild-snapshot.ts",
    "db:release-locks": "deno run -A ./scripts/migrations/release-migration-locks.ts",
    "db:mark-applied": "deno run -A ./scripts/migrations/mark-pending-applied.ts",
    "db:consolidate": "deno run -A ./scripts/migrations/consolidate-migrations.ts",
    "seed": "deno run --allow-all ./scripts/seed/index.ts",
    "db:reset-gen-migrate-seed": "deno task db:reset && deno task db:generate && deno task db:migrate && deno task seed",
    "search:reindex": "deno run -A ./scripts/reindex-search.ts",
    "search:ping": "deno run -A ./scripts/ping-search.ts",
    "search:verify-nested": "deno run -A ./scripts/verify-nested-search.ts",
    "seed:tt05-metadata": "deno run -A ./scripts/seed/seed-tt05-processed-metadata.ts",
    "seed:tt05-fake": "deno run -A ./scripts/seed/seed-tt05-fake-files.ts",
    "seed:tt05-dossiers": "deno run -A ./scripts/seed/seed-tt05-fake-dossiers.ts",
  },
  "imports": {
}
}
