{
  "tasks": {
    "dev": "deno run -A cli/dev.ts",
    "dev-sohoa-backend": "cd packages/sohoa-backend &&  deno run --watch --allow-all main.ts",
    "test:all": "deno run -A scripts/run-all-tests.ts",
    "docs:view": "cd packages/sohoa-backend && deno run -A scripts/view-docs.ts"
  },
  "imports": {
    "@elysiajs/cors": "npm:@elysiajs/cors@^1.4.0",
    "@elysiajs/swagger": "npm:@elysiajs/swagger@^1.3.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.7",
    "dotenv": "npm:dotenv@^17.2.3",
    "drizzle-kit": "npm:drizzle-kit@^0.31.5",
    "elysia": "npm:elysia@^1.4.9",
    "drizzle-orm": "npm:drizzle-orm@^0.44.5",
    "drizzle-orm/pg-core": "npm:drizzle-orm@^0.44.5/pg-core",
    "pino": "npm:pino@^10.1.0",
    "pino-pretty": "npm:pino-pretty@^13.0.0",
    "pino-roll": "npm:pino-roll@^1.0.0",
    "postgres": "npm:postgres@^3.4.4",
    "@shared/base-crud": "./shared/base-crud/mod.ts",
    "@shared/base-repo": "./shared/base-repo/mod.ts",
    "@shared/common-lib": "./shared/common-lib/mod.ts",
    "zod": "npm:zod@^3.23.8",
    "@shared/http-libs": "./shared/http-libs/mod.ts",
    "ramda": "npm:ramda@^0.32.0",
    "uuid": "npm:uuid@^13.0.0",
    "bentocache": "npm:bentocache@latest",
    "bentocache/drivers/memory": "npm:bentocache@latest/drivers/memory",
    "xlsx": "npm:xlsx@0.18.5",
    "pdf-lib": "npm:pdf-lib@1.17.1",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@^1.1.1",
    "mupdf": "npm:mupdf@1.26.4",
    "node-forge": "npm:node-forge@^1.3.1",
    "minio": "npm:minio@^7.1.3",
    "jose": "npm:jose@^5.9.6",
    "bcryptjs": "npm:bcryptjs@^2.4.3",
    "exceljs": "npm:exceljs@4.4.0",
    "jszip": "npm:jszip@3.10.1",
    "@zip.js/zip.js": "npm:@zip.js/zip.js@2.7.57",
    "kafkajs": "npm:kafkajs@^2.2.4",
    "socket.io": "npm:socket.io@^4.8.1",
    "@shared/search-engine": "./shared/search-engine/mod.ts"
  },
  "workspace": [
    "packages/*",
    "shared/*"
  ],
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 160,
    "semiColons": false,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "require-await"
      ]
    }
  },
  "vendor": true,
  "nodeModulesDir": "auto"
}